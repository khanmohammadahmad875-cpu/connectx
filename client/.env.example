# Frontend API base URL (no secrets belong in frontend env files).
# Leave EMPTY for same-origin requests: production serves the client from
# the API server itself, and local dev proxies /api + /socket.io to the
# backend (see vite.config.js). Only set this for a split deploy where the
# API lives on a different origin, e.g. VITE_API_URL=https://api.example.com
VITE_API_URL=
